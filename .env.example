# ==========================================================
# AGUERO SYSTEM CONFIGURATION — EXAMPLE
# Copy this file to .env and fill in your values.
# WARNING: NEVER push your .env file to GitHub — it contains secrets!
# ==========================================================

# ----------------------------------------------------------
# 1. AI / LLM CONFIGURATION
# ----------------------------------------------------------

# Anthropic (Claude) — used by the orchestrator when LLM_PROVIDER=anthropic (default)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ollama — used by ai-service-fastapi for email classification (REQUIRED)
# Get a free API key at https://ollama.com/settings/keys
OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:20b

# LLM provider for the orchestrator decision loop: "anthropic" or "ollama"
LLM_PROVIDER=anthropic
CLAUDE_MODEL=claude-opus-4-5

# ----------------------------------------------------------
# 2. MCP SERVER & SECURITY
# ----------------------------------------------------------

# AES-256-GCM encryption key for IMAP passwords stored in PostgreSQL.
# MUST be exactly 32 characters. CHANGE THIS before any production deployment!
ENCRYPTION_KEY=CHANGE_ME_TO_A_32_CHAR_SECRET_KEY

# ----------------------------------------------------------
# 3. LEGACY SINGLE-USER MODE (Optional)
# ----------------------------------------------------------
# Only needed if you are NOT using the multi-tenant DB registration flow.
# If IMAP_USER / IMAP_PASS are set, the Rust server will use them as a fallback
# when no user_id is supplied in a tool call.

IMAP_SERVER=imap.gmail.com
# IMAP_USER=your.email@gmail.com
# IMAP_PASS=your_gmail_app_password_here
