MCP_SERVER_URL=http://localhost:8080/mcp
AI_SERVICE_URL=http://localhost:8000
POLL_INTERVAL_SECONDS=60

# Which MCP transport to open against MCP_SERVER_URL.
#   auto -- let the SDK negotiate; this means Streamable HTTP (POST to the URL).
#   sse  -- force the older HTTP+SSE transport: GET the URL for the event stream,
#           POST commands to the endpoint it advertises. This is what
#           mcp-server-rust implements, so point it there with MCP_TRANSPORT=sse.
MCP_TRANSPORT=auto

# LLM_PROVIDER picks which model drives the label/move decision loop: "anthropic" or "ollama".
LLM_PROVIDER=anthropic

# Required when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=your-api-key-goes-here
CLAUDE_MODEL=claude-opus-5

# Used when LLM_PROVIDER=ollama. Defaults target the hosted https://ollama.com API, which needs
# OLLAMA_API_KEY. Point OLLAMA_BASE_URL at a self-hosted daemon instead if you run your own --
# then also set OLLAMA_FORMAT_MODE=schema and clear OLLAMA_THINK for models that reject it.
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_FORMAT_MODE=json
OLLAMA_THINK=low
OLLAMA_TIMEOUT_SECONDS=30
