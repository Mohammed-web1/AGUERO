# Ollama's hosted API is the only thing this service needs. Get a free key at
# https://ollama.com/settings/keys and put it in .env, which is gitignored.
OLLAMA_API_KEY=your-ollama-key

# Defaults, shown for reference -- none of these need setting.
# OLLAMA_BASE_URL=https://ollama.com
# OLLAMA_MODEL=gpt-oss:20b
# OLLAMA_FORMAT_MODE=json     # hosted API ignores schema-constrained decoding
# OLLAMA_THINK=low            # reasoning effort; keeps latency inside budget
# OLLAMA_TIMEOUT_SECONDS=9    # must stay under the orchestrator's 10s timeout
# OLLAMA_NUM_CTX=4096
# MAX_CONTENT_CHARS=6000
# MAX_REQUEST_BYTES=1048576   # bodies over this are refused with 413
# ENABLE_HEURISTIC_FALLBACK=true
# LOG_LEVEL=INFO

# Pointing at a self-hosted daemon is the same HTTP API, but local models need
# schema mode and reject the think field:
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_FORMAT_MODE=schema
# OLLAMA_THINK=
